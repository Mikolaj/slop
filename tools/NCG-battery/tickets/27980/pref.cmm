#include "Cmm.h"

helper (W_ x)
{
    return (x + 1);
}

pref_clash (W_ a, W_ n, W_ m)
{
    W_ i, x;

    (W_ r) = call helper(n);
    if (r == 0) goto early;
    goto mid;

early:
    return (a);

mid:
    (W_ s) = call helper(r + a);
    if (s == 5) goto other;
    goto setup;

other:
    return (m);

setup:
    i = s + a + m;
    goto check;

check:
    if (i >= n) goto done;
    x = W_[a + i * 8];
    (W_ y) = call helper(x);
    i = i + 1;
    goto check;

done:
    return (i);
}
